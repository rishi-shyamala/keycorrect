<?xml version="1.0" encoding="utf-8"?>
<!--
  The KeyCorrect neural pack: the language model (an uncompressed asset) and the llama.cpp native
  library, nothing else. No code, no activity, no permissions (not even INTERNET). The keyboard
  (dev.keycorrect) loads the library and reads the model from this package, after checking that
  both APKs are signed with the same key (docs/PHASE7.md).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:hasCode="false"
        android:label="KeyCorrect neural pack" />
</manifest>
