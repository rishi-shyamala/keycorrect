// The extra-keys row of terminal fields (TYPE_NULL), composed above every layer.
{
  "format": 1,
  "id": "terminal_row",
  "name": "Terminal keys",
  "kind": "extra",
  "rows": [
    {
      "height": 0.85,
      "keys": [
        { "type": "keycode", "width": 1.25, "code": "escape", "label": "Esc", "description": "Escape" },
        { "type": "keycode", "width": 1.25, "code": "tab", "label": "Tab", "description": "Tab" },
        { "type": "modifier", "width": 1.25, "modifier": "ctrl" },
        { "type": "modifier", "width": 1.25, "modifier": "alt" },
        {
          "width": 1.25, "type": "keycode", "code": "left", "label": "←", "description": "Left",
          "popup": [{ "type": "keycode", "code": "home", "label": "Home" }]
        },
        {
          "width": 1.25, "type": "keycode", "code": "down", "label": "↓", "description": "Down",
          "popup": [{ "type": "keycode", "code": "pageDown", "label": "PgDn" }]
        },
        {
          "width": 1.25, "type": "keycode", "code": "up", "label": "↑", "description": "Up",
          "popup": [{ "type": "keycode", "code": "pageUp", "label": "PgUp" }]
        },
        {
          "width": 1.25, "type": "keycode", "code": "right", "label": "→", "description": "Right",
          "popup": [{ "type": "keycode", "code": "end", "label": "End" }]
        }
      ]
    }
  ]
