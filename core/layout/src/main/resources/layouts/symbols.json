// Symbols layer, page 1: digits, the shifted digits in US order, then punctuation.
// Row 3 lines up with the letters' row 3 (1.5u page key, 7 keys, 1.5u backspace). The bottom row is
// appended at runtime (bottomRow: auto). With the number row on, numberRowExtra adds a row of operators
// under the digits so this page has as many rows as the letters.
{
  "format": 1,
  "id": "symbols",
  "name": "Symbols",
  "kind": "symbols",
  "rows": [
    [
      { "label": "1", "hint": null, "popup": ["¹", "½", "⅓", "¼", "⅛"] },
      { "label": "2", "hint": null, "popup": ["²", "⅔"] },
      { "label": "3", "hint": null, "popup": ["³", "¾", "⅜"] },
      { "label": "4", "hint": null, "popup": ["⁴"] },
      "5",
      "6",
      "7",
      "8",
      "9",
      { "label": "0", "hint": null, "popup": ["⁰", "∅"] },
    ],
    [
      { "label": "!", "popup": ["¡"] },
      "@",
      { "label": "#", "popup": ["№"] },
      { "label": "$", "popup": ["€", "£", "¥", "¢"] },
      { "label": "%", "popup": ["‰"] },
      "^",
      { "label": "&", "popup": ["§"] },
      { "label": "*", "popup": ["†", "‡", "★"] },
      { "label": "(", "popup": ["[", "{", "<"] },
      { "label": ")", "popup": ["]", "}", ">"] },
    ],
    [
      { "type": "layer", "label": "1/2", "target": "symbols2", "style": "modifier", "description": "More symbols" },
      { "label": "-", "popup": ["+", "_", "–", "—"] },
      { "label": "'", "popup": ["`", "‘", "’"] },
