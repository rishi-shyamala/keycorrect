// Bottom row for email address fields. Widths here are placeholders: the composer sizes the side keys to
// ComposeOptions.bottomKeyWidth and gives the rest of the 10 units to the space key.
{
  "format": 1,
  "id": "bottom_email",
  "name": "Bottom row (email)",
  "kind": "bottom",
  "rows": [
    [
      { "type": "modeSwitch", "width": 1.5 },
      { "type": "emoji" },
      { "type": "space", "width": 4 },
      "@",
      ".",
      { "type": "enter", "width": 1.5 },
    ],
  ],
}
