// Bottom row for URL fields. Widths here are placeholders: the composer sizes the side keys to
// ComposeOptions.bottomKeyWidth and gives the rest of the 10 units to the space key.
{
  "format": 1,
  "id": "bottom_url",
  "name": "Bottom row (URL)",
  "kind": "bottom",
  "rows": [
    [
      {
        "type": "modeSwitch", "width": 1.5, "hint": null,
        "popup": [
          { "type": "fieldMode", "mode": "text" },
          { "type": "fieldMode", "mode": "email" },
          { "type": "fieldMode", "mode": "url" },
          { "type": "fieldMode", "mode": "number" },
          { "type": "fieldMode", "mode": "phone" },
        ],
      },
      { "type": "emoji" },
      "/",
      { "type": "space", "width": 4 },
      { "label": ".", "popup": [".com", ".org", ".net", ".io", ".dev", ".app"] },
      { "type": "enter", "width": 1.5 },
    ],
  ],
}
