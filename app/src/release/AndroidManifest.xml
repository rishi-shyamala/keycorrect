<?xml version="1.0" encoding="utf-8"?>
<!--
  Release builds only. androidx.profileinstaller adds an exported receiver (guarded by the shell-only
  DUMP permission) so that profiles can be installed over adb. It is not needed to run the app (the
  ProfileInstallerInitializer installs the baseline profile at startup), so it is removed to keep the
  exported surface at what docs/PLAN.md section 15 allows (docs/SECURITY.md).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />
    </application>
</manifest>
