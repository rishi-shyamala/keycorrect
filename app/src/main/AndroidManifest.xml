<?xml version="1.0" encoding="utf-8"?>
<!--
  Privacy: keep permissions minimal, and never request android.permission.INTERNET
  (docs/PLAN.md §15, decision D3).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Custom key-press haptics (duration/strength settings). Normal, install-time permission. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Voice typing (docs/PHASE6.md): the microphone, only while dictating. Runtime permission,
      requested by MicPermissionActivity (a keyboard cannot show the dialog). Audio never leaves the
      device: there is no INTERNET permission.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Package visibility (Android 11+) for the speech recognizers and the voice pack. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <package android:name="dev.keycorrect.voice" />
        <package android:name="dev.keycorrect.neural" />
    </queries>

    <application
        android:name=".KeyCorrectApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KeyCorrect">

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Asks for the microphone on behalf of the keyboard, then finishes at once. -->
        <activity
            android:name=".voice.MicPermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.KeyCorrect.Transparent" />

        <!--
          Serves image clips to the app they are pasted into. Never exported: another app reaches a
          URI only through a per-URI grant (commitContent, or the system clipboard's grant).
        -->
        <provider
            android:name=".ime.ClipImageProvider"
            android:authorities="${applicationId}.clips"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!--
          The built-in language-model engine (docs/PHASE7.md), in its own process so a crash or
          out-of-memory there never takes the keyboard down. Bound explicitly by the keyboard:
          no intent filter, not exported.
        -->
        <service
            android:name=".neural.NeuralEngineService"
            android:exported="false"
            android:process=":engine" />

        <service
            android:name=".ime.KeyCorrectImeService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
