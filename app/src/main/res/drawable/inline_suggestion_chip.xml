<?xml version="1.0" encoding="utf-8"?>
<!--
  Background of the inline autofill chips. Solid white on purpose: it is tinted at runtime with the
  dynamic Material surface colour (see InlineSuggestionsRequestFactory). The corner radius is half
  the chip height so the chip is a pill.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFFFF" />
    <corners android:radius="18dp" />
</shape>
