<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: field lab for device-testing the keyboard without third-party apps. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="dev.keycorrect.fieldlab.FieldLabActivity"
            android:exported="true"
            android:label="KeyCorrect field lab"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Serves the field lab's generated test image (clipboard image tests). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fieldlab"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/fieldlab_paths" />
        </provider>
    </application>
</manifest>
